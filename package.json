{
  "name": "autogrowx-mission-control",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run build -w @autogrowx/web",
    "db:generate": "npm run generate --workspace=@autogrowx/database",
    "db:push": "npm run push --workspace=@autogrowx/database"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
