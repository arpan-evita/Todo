{
  "name": "autogrowx-mission-control",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run build -w @autogrowx/web && mkdir -p dist && cp -r apps/web/dist/* dist/",
    "db:generate": "npm run generate --workspace=@autogrowx/database",
    "db:push": "npm run push --workspace=@autogrowx/database"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.1",
    "@capacitor/local-notifications": "^8.0.2",
    "@capacitor/push-notifications": "^8.0.3",
    "@supabase/supabase-js": "^2.43.4",
    "autoprefixer": "^10.4.20",
    "next": "15.1.11",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
